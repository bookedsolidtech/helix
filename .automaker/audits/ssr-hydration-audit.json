  "sharedStrategies": {
    "nextjs-app-router": {
      "description": "Next.js 15 App Router SSR strategy for HELiX web components",
      "pattern": "All HELiX components require 'use client' boundary since they register custom elements. Create a ClientComponents wrapper that imports and re-exports components.",
      "recommendation": "Use dynamic imports with next/dynamic for code splitting. Place 'use client' at the boundary component level, not at each individual component usage.",
      "hydrationWarningFix": "No crypto.randomUUID() usage in codebase. Module-level counters produce deterministic IDs. No suppressHydrationWarning needed."
    },
    "astro-islands": {
      "description": "Astro 5 island architecture for HELiX web components",
      "pattern": "Use client:load for interactive components, client:idle for non-critical interactive, client:visible for below-fold, and no directive for SSR-safe display-only components (with @lit-labs/ssr).",
      "recommendation": "Create wrapper .astro components that handle the client directive selection based on component category from this audit."
    },
    "nuxt-ssr": {
      "description": "Nuxt 4 SSR strategy for HELiX web components",
      "pattern": "Register components in a .client.ts plugin to ensure they only load client-side. Use <ClientOnly> wrapper for client-only components. Use defineNuxtPlugin with mode: 'client'.",
      "recommendation": "Create a composable useSsrSafe() that checks typeof window for conditional rendering."
