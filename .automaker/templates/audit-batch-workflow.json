{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Workflow configuration template for audit batch jobs in protoMaker",
  "workflow": {
    "name": "audit-batch",
    "type": "sequential",
    "description": "Batch audit execution: sequential agents on shared branch, single PR, single CI",
    "phases": {
      "initialize": {
        "description": "Create batch branch and metadata",
        "script": "scripts/create-audit-batch-branch.sh",
        "timeout": "5m"
      },
      "execute": {
        "description": "Sequential agent execution per component",
        "type": "sequential-loop",
        "agentModel": "sonnet",
        "timeoutPerComponent": "30m",
        "maxRetries": 1,
        "onZombie": "skip-and-continue"
      },
      "consolidate": {
        "description": "Generate consolidated changeset and validate shared files",
        "scripts": [
          ".automaker/scripts/consolidate-audit-changeset.js",
          ".automaker/scripts/consolidate-shared-files.js --check"
        ],
        "timeout": "5m"
      },
      "finalize": {
        "description": "Finalize batch and prepare for PR",
        "script": "scripts/finalize-audit-batch.sh",
        "timeout": "5m"
      },
      "publish": {
        "description": "Create PR with auto-merge",
        "script": ".automaker/scripts/create-audit-batch-pr.js",
        "timeout": "5m"
      }
    }
  },
  "agentRouting": {
    "default": "sonnet",
    "auditTypes": {
      "accessibility": {
        "agent": "accessibility-engineer",
        "model": "sonnet"
      },
      "code-quality": {
        "agent": "chief-code-reviewer",
        "model": "opus"
      },
      "performance": {
        "agent": "performance-engineer",
        "model": "sonnet"
      },
      "tokens": {
        "agent": "design-system-developer",
        "model": "sonnet"
      },
      "deep-quality": {
        "agent": "code-reviewer",
        "model": "sonnet"
      }
    }
  },
  "concurrency": {
    "slotsConsumed": 1,
    "description": "Entire batch consumes 1 concurrency slot (not 1 per component)",
    "parallelAgents": false
  },
  "timing": {
    "estimatedMinutesPerComponent": 15,
    "batchOverheadMinutes": 10,
    "formula": "(components * minutesPerComponent) + batchOverheadMinutes"
  },
  "gitWorkflow": {
    "autoCommit": true,
    "autoPush": false,
    "autoCreatePR": false,
    "commitPrefix": "audit"
  }
}
