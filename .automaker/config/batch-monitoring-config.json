{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Configuration for audit batch progress monitoring and Discord notifications",
  "monitoring": {
    "enabled": true,
    "checkpointInterval": "per-component",
    "progressUpdateMinutes": 5,
    "zombieDetectionMinutes": 20,
    "staleThresholdMinutes": 30
  },
  "discord": {
    "enabled": true,
    "channels": {
      "progress": {
        "name": "dev-helix",
        "channelId": "1478216123265847428",
        "events": ["batch-start", "batch-complete", "component-complete"]
      },
      "alerts": {
        "name": "dev-alerts",
        "channelId": "1478216352094224496",
        "events": ["component-failed", "zombie-detected", "batch-stalled"]
      },
      "lifecycle": {
        "name": "agent-logs",
        "channelId": "1480582601352679566",
        "events": ["agent-start", "agent-stop", "state-transition"]
      }
    },
    "messageFormat": {
      "batchStart": "🚀 **Audit batch started:** `{batchId}` — {componentCount} components on `{branch}`",
      "componentComplete": "✅ `{component}` audited ({completedCount}/{totalCount}) — batch `{batchId}`",
      "componentFailed": "❌ `{component}` failed — batch `{batchId}`",
      "batchComplete": "🎉 **Audit batch complete:** `{batchId}` — {completedCount}/{totalCount} in {durationMinutes}min",
      "zombieDetected": "⚠️ Zombie detected: `{component}` stuck for {elapsedMinutes}min — batch `{batchId}`",
      "batchStalled": "🛑 Batch stalled: no progress for {stalledMinutes}min — batch `{batchId}`"
    }
  },
  "timing": {
    "expectedMinutesPerComponent": 15,
    "warningMultiplier": 1.5,
    "criticalMultiplier": 2.0
  },
  "reporting": {
    "generateSummaryOnComplete": true,
    "summaryOutputPath": ".automaker/audits/batch-{date}-summary.md",
    "includeTimingBreakdown": true,
    "includeCIImpactAnalysis": true
  }
}
