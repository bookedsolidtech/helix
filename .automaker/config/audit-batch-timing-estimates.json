{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Timing estimates for audit batch planning and monitoring",
  "estimates": {
    "perComponent": {
      "accessibility": {
        "averageMinutes": 15,
        "minMinutes": 8,
        "maxMinutes": 30,
        "description": "WCAG 2.1 AA audit: ARIA, keyboard, focus, contrast"
      },
      "code-quality": {
        "averageMinutes": 12,
        "minMinutes": 5,
        "maxMinutes": 25,
        "description": "TypeScript, patterns, dead code, API design"
      },
      "performance": {
        "averageMinutes": 10,
        "minMinutes": 5,
        "maxMinutes": 20,
        "description": "Bundle size, render perf, lazy loading"
      },
      "tokens": {
        "averageMinutes": 8,
        "minMinutes": 3,
        "maxMinutes": 15,
        "description": "Hardcoded values, token coverage, cascade"
      },
      "deep-quality": {
        "averageMinutes": 20,
        "minMinutes": 10,
        "maxMinutes": 35,
        "description": "Combined audit covering multiple quality dimensions"
      }
    },
    "batchOverhead": {
      "initializationMinutes": 2,
      "finalizationMinutes": 3,
      "prCreationMinutes": 2,
      "ciRunMinutes": 8,
      "totalOverheadMinutes": 15
    }
  },
  "formulas": {
    "estimatedBatchDuration": "(components * perComponentAverage) + batchOverhead",
    "ciJobReduction": "((components * 15) - 15) / (components * 15) * 100",
    "timeToMerge": "estimatedBatchDuration + ciRunMinutes + 5"
  },
  "thresholds": {
    "zombieDetectionMinutes": 20,
    "warningMinutesPerComponent": 25,
    "criticalMinutesPerComponent": 35,
    "maxBatchDurationHours": 8
  },
  "historicalData": {
    "description": "Updated as batches complete to improve estimates",
    "batches": []
  }
}
