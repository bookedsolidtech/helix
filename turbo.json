{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        ".astro/**",
        ".next/**",
        "custom-elements.json",
        "aaa-verdicts.json",
        "figma-inventory.json"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [".cache/test-results.json"]
    },
    "test:smart": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "cem": {
      "dependsOn": ["^build"],
      "outputs": ["custom-elements.json"]
    },
    "prebuild": {
      "dependsOn": ["^cem"],
      "outputs": []
    },
    "generate": {
      "dependsOn": ["^cem"],
      "outputs": ["packages/hx-react/src/components/**"]
    },
    "generate:drupal-libraries": {
      "dependsOn": ["cem"],
      "outputs": ["packages/drupal-starter/helixui.libraries.yml"]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "storybook:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
