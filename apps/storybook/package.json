{
  "name": "@helixui/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook design system playground for WC-2026 components",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 3151 --no-open",
    "build": "storybook build -o dist",
    "build-storybook": "storybook build -o dist",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS='--max-old-space-size=3072' node scripts/test-shards.mjs",
    "test:single": "NODE_OPTIONS='--max-old-space-size=3072' vitest run"
  },
  "dependencies": {
    "@helixui/library": "workspace:*",
    "@helixui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.0.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/web-components-vite": "^10.3.6",
    "lit": "^3.3.2",
    "storybook": "^10.3.6",
    "vitest": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "vite": "^6.2.0"
  }
}
