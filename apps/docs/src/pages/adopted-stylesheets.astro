          </div>

          <div class="as-grid-2" style="margin-bottom: var(--space-8);">
            <div>
              <h3 style="font-size: 1rem; font-weight: 700; margin: 0 0 var(--space-4); color: var(--text-primary);">
                3 steps to fix broken slot styles
              </h3>
              <div class="as-migration-steps">
                <div class="as-migration-step">
                  <div class="as-migration-step-num">1</div>
                  <div class="as-migration-step-body">
                    <h4>Import the controller</h4>
                    <p>Add the import at the top of your component file.</p>
                    <code>import &#123; AdoptedStylesheetsController &#125; from '../controllers/adopted-stylesheets.js';</code>
                  </div>
                </div>
                <div class="as-migration-step">
                  <div class="as-migration-step-num">2</div>
                  <div class="as-migration-step-body">
                    <h4>Declare a private controller field</h4>
                    <p>
                      Write the CSS that should reach slotted content. Use your component tag name as
                      the selector scope so styles don't leak globally.
                    </p>
                    <code>private _slotStyles = new AdoptedStylesheetsController(this, `hx-card p &#123; ... &#125;`);</code>
                  </div>
                </div>
                <div class="as-migration-step">
                  <div class="as-migration-step-num">3</div>
                  <div class="as-migration-step-body">
                    <h4>Verify and ship</h4>
                    <p>
                      Run <code>pnpm run type-check</code> — zero errors expected.
                      Test in Drupal or your consumer. Slotted content now receives design tokens.
                    </p>
                    <code>pnpm run test:smart</code>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <div class="as-code-window" role="region" aria-label="Migration code example">
                <div class="as-code-window-header">
                  <div class="as-code-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <span class="as-code-filename">hx-article.ts — before and after</span>
                </div>
                <pre class="as-code"><code><span class="c-comment">// ❌ BEFORE — slot styles are broken</span>
<span class="c-keyword">export class</span> <span class="c-type">HxArticle</span> <span class="c-keyword">extends</span> <span class="c-type">LitElement</span> {
  <span class="c-keyword">static override</span> styles = css<span class="c-string">`
