  <script is:inline>
    (function () {
      /* ---- Back-to-top button ---- */
      var topBtn = document.getElementById('as-back-to-top');
      function checkScroll() {
        if (window.scrollY > window.innerHeight * 0.4) {
          topBtn.classList.add('visible');
        } else {
          topBtn.classList.remove('visible');
        }
      }
      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
      topBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      /* ---- Section dot nav ---- */
      var sectionIds = [
        's-hero', 's-problem', 's-solution', 's-demos',
        's-how', 's-frameworks', 's-perf', 's-migration', 's-compare'
      ];
      var dots = document.querySelectorAll('.as-nav-dot');

      function updateDots() {
        var scrollY = window.scrollY + window.innerHeight * 0.35;
        var active = 0;
        for (var i = 0; i < sectionIds.length; i++) {
          var el = document.getElementById(sectionIds[i]);
          if (el && el.offsetTop <= scrollY) {
            active = i;
          }
        }
        dots.forEach(function (d, idx) {
          d.classList.toggle('active', idx === active);
        });
      }

      window.addEventListener('scroll', updateDots, { passive: true });
      updateDots();

      dots.forEach(function (dot, idx) {
        dot.addEventListener('click', function () {
          var target = document.getElementById(sectionIds[idx]);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      /* ---- Framework tabs ---- */
      var tabBtns = document.querySelectorAll('.as-tab');
      var tabPanels = document.querySelectorAll('.as-tab-panel');

      tabBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('aria-controls');
          tabBtns.forEach(function (b) {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          tabPanels.forEach(function (p) {
            p.classList.remove('active');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          var panel = document.getElementById(targetId);
          if (panel) panel.classList.add('active');
        });
      });

      /* ---- Controller toggle demo ---- */
      var toggleBtn = document.getElementById('as-toggle-btn');
      var toggleIcon = document.getElementById('as-toggle-icon');
      var toggleStatus = document.getElementById('as-toggle-status');
      var liveStyled = document.querySelector('.as-live-styled');
      var isOn = true;

      var originalStyles = {
        fontFamily: '',
        color: '',
        background: '',
        border: '',
        borderRadius: '',
        lineHeight: ''
      };

      if (toggleBtn && liveStyled) {
        toggleBtn.addEventListener('click', function () {
          isOn = !isOn;
          toggleBtn.setAttribute('aria-pressed', isOn ? 'true' : 'false');

          if (isOn) {
            toggleIcon.className = 'fa-solid fa-toggle-on';
            toggleBtn.childNodes[toggleBtn.childNodes.length - 1].textContent = ' Controller: ON';
            toggleStatus.style.color = 'var(--wc-green)';
            toggleStatus.innerHTML = '<i class="fa-solid fa-circle" style="font-size:0.5rem;" aria-hidden="true"></i> Styles active';
            liveStyled.style.removeProperty('font-family');
            liveStyled.style.removeProperty('color');
            liveStyled.style.removeProperty('background');
            liveStyled.style.removeProperty('border');
            liveStyled.style.removeProperty('border-radius');
            liveStyled.style.removeProperty('line-height');
          } else {
            toggleIcon.className = 'fa-solid fa-toggle-off';
            toggleBtn.childNodes[toggleBtn.childNodes.length - 1].textContent = ' Controller: OFF';
            toggleStatus.style.color = 'var(--wc-red)';
            toggleStatus.innerHTML = '<i class="fa-solid fa-circle" style="font-size:0.5rem;" aria-hidden="true"></i> Styles removed';
            liveStyled.style.fontFamily = "'Times New Roman', serif";
            liveStyled.style.color = '#000';
            liveStyled.style.background = '#fff';
            liveStyled.style.border = '1px solid #ccc';
            liveStyled.style.borderRadius = '0';
            liveStyled.style.lineHeight = '1.4';
          }
        });
      }
    })();
  </script>
