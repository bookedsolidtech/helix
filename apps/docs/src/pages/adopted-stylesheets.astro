---
/**
 * Adopted Stylesheets Showcase Page
 *
 * Demonstrates AdoptedStylesheetsController — the canonical solution
 * for styling slotted/light-DOM content in HELiX web components.
 *
 * Sections:
 * 1. The Problem — Shadow DOM styles don't reach slotted content
 * 2. The Solution — AdoptedStylesheetsController in 3 lines
 * 3. Live Interactive Demos — Before/after comparisons
 * 4. How It Works — Visual cascade diagram
 * 5. Framework Examples — Drupal, React, Vue, vanilla JS
 * 6. Performance — Caching, reference counting, WeakMap IDs
 * 7. Migration Guide — Fix broken styles in 3 lines
 * 8. Comparison — vs ::slotted(), global CSS, inline styles, CSS-in-JS
 */
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
  title="AdoptedStylesheetsController"
  description="One controller that solves Shadow DOM's slotted-content styling gap. The default pattern for every HELiX consumer."
>
  <style is:inline>
    /* ============================================
       ADOPTED STYLESHEETS SHOWCASE — page styles
       ============================================ */

    body { overflow-x: hidden; }
    html { scroll-behavior: smooth; }

    /* ---- Page layout ---- */
    .as-page {
      background: var(--surface-0);
      min-height: 100vh;
      color: var(--text-primary);
      font-family: var(--font-body);
    }

    /* ---- Top utility nav ---- */
    .as-util-nav {
      position: fixed;
      bottom: var(--space-6);
      left: var(--space-6);
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .as-util-btn {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--glass-bg-strong);
      border: 1px solid var(--glass-border-strong);
      border-radius: 50%;
      color: var(--text-secondary);
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .as-util-btn:hover {
      color: var(--text-primary);
      background: rgba(6, 182, 212, 0.15);
      border-color: rgba(6, 182, 212, 0.3);
      transform: translateY(-2px);
      box-shadow: 0 4px 20px rgba(6, 182, 212, 0.2);
    }
    .as-util-btn:focus-visible {
      outline: 3px solid var(--wc-accent);
      outline-offset: 3px;
    }
    .as-util-btn--top { opacity: 0; pointer-events: none; transition: all 0.3s ease; }
    .as-util-btn--top.visible { opacity: 1; pointer-events: auto; }

    /* ---- Section dot nav ---- */
    .as-section-nav {
      position: fixed;
      right: var(--space-6);
      top: 50%;
      transform: translateY(-50%);
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .as-nav-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--glass-border-strong);
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      padding: 0;
    }
    .as-nav-dot.active {
      background: var(--wc-cyan);
      box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
      transform: scale(1.3);
    }
    .as-nav-dot:hover { background: var(--text-muted); transform: scale(1.2); }
    .as-nav-dot-label {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
      background: rgba(10, 10, 20, 0.9);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
    }
    .as-nav-dot:hover .as-nav-dot-label { opacity: 1; }
    .as-nav-dot:focus-visible { outline: 3px solid var(--wc-accent); outline-offset: 3px; }

    /* ---- Shared section base ---- */
    .as-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 5.5rem 2rem 4rem;
    }
    .as-section-inner {
      max-width: 1100px;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    /* ---- Section backgrounds ---- */
    .as-section--dark { background: var(--surface-0); }
    .as-section--mid  { background: var(--surface-1); }

    /* ---- Hero gradient overlay ---- */
    .as-hero {
      background: linear-gradient(135deg, #050510 0%, #0b0b25 35%, #150a28 65%, #050510 100%);
    }
    .as-hero-grid {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
      background-size: 60px 60px;
    }
    .as-hero-orb-1 {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.1) 0%, transparent 70%);
      top: -200px;
      right: -100px;
      pointer-events: none;
      animation: orb-drift-a 20s ease-in-out infinite alternate;
    }
    .as-hero-orb-2 {
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
      bottom: -150px;
      left: -100px;
      pointer-events: none;
      animation: orb-drift-b 25s ease-in-out infinite alternate;
    }

    @keyframes orb-drift-a {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(-40px, 30px) scale(1.08); }
    }
    @keyframes orb-drift-b {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(40px, -30px) scale(1.05); }
    }

    /* ---- Gradient text ---- */
    .gradient-text {
      background: var(--gradient-cyan-purple);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .gradient-text--green {
      background: var(--gradient-green-cyan);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .gradient-text--amber {
      background: linear-gradient(135deg, var(--wc-amber), var(--wc-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ---- Section header ---- */
    .as-section-header { text-align: center; margin-bottom: 3rem; }
    .as-section-label {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 0.3rem 1rem;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
    }
    .label-red    { background: rgba(239,68,68,0.1);   color: var(--wc-red);    border: 1px solid rgba(239,68,68,0.2); }
    .label-cyan   { background: rgba(6,182,212,0.1);   color: var(--wc-cyan);   border: 1px solid rgba(6,182,212,0.2); }
    .label-green  { background: rgba(16,185,129,0.1);  color: var(--wc-green);  border: 1px solid rgba(16,185,129,0.2); }
    .label-accent { background: rgba(139,92,246,0.1);  color: var(--wc-accent); border: 1px solid rgba(139,92,246,0.2); }
    .label-amber  { background: rgba(245,158,11,0.1);  color: var(--wc-amber);  border: 1px solid rgba(245,158,11,0.2); }
    .label-electric { background: rgba(59,130,246,0.1); color: var(--wc-electric); border: 1px solid rgba(59,130,246,0.2); }
    .label-pink   { background: rgba(236,72,153,0.1);  color: var(--wc-pink);   border: 1px solid rgba(236,72,153,0.2); }
    .label-teal   { background: rgba(20,184,166,0.1);  color: var(--wc-teal);   border: 1px solid rgba(20,184,166,0.2); }

    .as-section-title {
      font-size: clamp(1.875rem, 4vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
      line-height: 1.15;
    }
    .as-section-desc {
      font-size: 1.0625rem;
      color: var(--text-secondary);
      max-width: 720px;
      margin: 0 auto;
      line-height: 1.8;
    }

    /* ---- Code block (pre/code) ---- */
    .as-code {
      background: var(--surface-2);
      border: 1px solid var(--surface-3);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-6);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      line-height: 1.7;
      overflow-x: auto;
      margin: 0;
    }
    .as-code .c-comment { color: #6c7986; font-style: italic; }
    .as-code .c-keyword { color: #c792ea; }
    .as-code .c-string  { color: #c3e88d; }
    .as-code .c-prop    { color: #82aaff; }
    .as-code .c-call    { color: #89ddff; }
    .as-code .c-num     { color: #f78c6c; }
    .as-code .c-type    { color: #ffcb6b; }
    .as-code .c-tag     { color: #f07178; }
    .as-code .c-attr    { color: #c3e88d; }
    .as-code .c-value   { color: #89ddff; }

    /* ---- Code window chrome ---- */
    .as-code-window {
      background: var(--surface-1);
      border: 1px solid var(--surface-3);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }
    .as-code-window-header {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.625rem var(--space-4);
      background: var(--surface-2);
      border-bottom: 1px solid var(--surface-3);
    }
    .as-code-dots { display: flex; gap: 6px; }
    .as-code-dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--surface-3); }
    .as-code-dots span:first-child { background: #ef4444; }
    .as-code-dots span:nth-child(2) { background: #f59e0b; }
    .as-code-dots span:last-child { background: #10b981; }
    .as-code-filename {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
    }

    /* ---- Glass card ---- */
    .as-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border-strong);
      border-radius: var(--radius-xl);
      padding: var(--space-6);
    }
    .as-card--highlight {
      background: rgba(6, 182, 212, 0.04);
      border-color: rgba(6, 182, 212, 0.2);
    }
    .as-card--danger {
      background: rgba(239, 68, 68, 0.04);
      border-color: rgba(239, 68, 68, 0.2);
    }
    .as-card--success {
      background: rgba(16, 185, 129, 0.04);
      border-color: rgba(16, 185, 129, 0.2);
    }
    .as-card--warning {
      background: rgba(245, 158, 11, 0.04);
      border-color: rgba(245, 158, 11, 0.2);
    }

    /* ---- Two-column grid ---- */
    .as-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    /* ---- Three-column grid ---- */
    .as-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    /* ---- Feature list ---- */
    .as-feature-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
    .as-feature-item { display: flex; align-items: flex-start; gap: var(--space-3); }
    .as-feature-icon { font-size: 1rem; margin-top: 2px; flex-shrink: 0; }
    .as-feature-text { font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.6; }
    .as-feature-text strong { color: var(--text-primary); font-weight: 600; }

    /* ---- Before/After demo ---- */
    .as-demo-panel {
      background: var(--surface-2);
      border: 1px solid var(--surface-3);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .as-demo-panel-header {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .as-demo-panel-header--bad  { background: rgba(239,68,68,0.12);  color: var(--wc-red);  border-bottom: 1px solid rgba(239,68,68,0.2); }
    .as-demo-panel-header--good { background: rgba(16,185,129,0.12); color: var(--wc-green); border-bottom: 1px solid rgba(16,185,129,0.2); }
    .as-demo-panel-body { padding: var(--space-4); }

    /* Live demo: unstyled text sim */
    .as-live-unstyled {
      font-family: 'Times New Roman', serif;
      font-size: 1rem;
      color: #000;
      background: #fff;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-sm);
      border: 1px solid #ccc;
      line-height: 1.4;
    }
    .as-live-unstyled p { margin: 0 0 0.5rem; }
    .as-live-unstyled p:last-child { margin-bottom: 0; }
    .as-live-unstyled h3 { font-size: 1.125rem; font-weight: bold; margin: 0 0 0.25rem; }

    /* Live demo: styled text sim */
    .as-live-styled {
      font-family: var(--font-body);
      font-size: 0.9375rem;
      color: var(--text-primary);
      background: var(--surface-2);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-sm);
      border: 1px solid rgba(6,182,212,0.2);
      line-height: 1.65;
    }
    .as-live-styled h3 {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--wc-cyan);
      margin: 0 0 var(--space-2);
    }
    .as-live-styled p { margin: 0 0 var(--space-2); color: var(--text-secondary); }
    .as-live-styled p:last-child { margin-bottom: 0; }
    .as-live-styled .as-live-tag {
      display: inline-block;
      padding: 0.125rem 0.5rem;
      background: rgba(16,185,129,0.1);
      color: var(--wc-green);
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid rgba(16,185,129,0.2);
    }

    /* ---- Problem callout ---- */
    .as-problem-callout {
      background: rgba(239,68,68,0.06);
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: var(--radius-lg);
      padding: var(--space-4) var(--space-6);
      margin-bottom: var(--space-6);
      display: flex;
      gap: var(--space-4);
      align-items: flex-start;
    }
    .as-problem-callout-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
    .as-problem-callout-body h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--wc-red);
      margin: 0 0 var(--space-2);
    }
    .as-problem-callout-body p {
      font-size: 0.9375rem;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.65;
    }

    /* ---- Solution callout ---- */
    .as-solution-callout {
      background: rgba(16,185,129,0.06);
      border: 1px solid rgba(16,185,129,0.25);
      border-radius: var(--radius-lg);
      padding: var(--space-4) var(--space-6);
      margin-bottom: var(--space-6);
      display: flex;
      gap: var(--space-4);
      align-items: flex-start;
    }
    .as-solution-callout-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
    .as-solution-callout-body h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--wc-green);
      margin: 0 0 var(--space-2);
    }
    .as-solution-callout-body p {
      font-size: 0.9375rem;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.65;
    }

    /* ---- Migration steps ---- */
    .as-migration-steps { display: flex; flex-direction: column; gap: var(--space-4); }
    .as-migration-step {
      display: flex;
      gap: var(--space-4);
      align-items: flex-start;
    }
    .as-migration-step-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--gradient-cyan-purple);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      font-weight: 800;
      color: #fff;
      flex-shrink: 0;
    }
    .as-migration-step-body { flex: 1; }
    .as-migration-step-body h4 {
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 var(--space-1);
    }
    .as-migration-step-body p {
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.6;
    }
    .as-migration-step-body code {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--wc-cyan);
      background: rgba(6,182,212,0.08);
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
    }

    /* ---- Cascade diagram ---- */
    .as-cascade {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-width: 600px;
      margin: 0 auto;
    }
    .as-cascade-node {
      background: var(--surface-2);
      border: 1px solid var(--surface-3);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-6);
      position: relative;
      text-align: center;
    }
    .as-cascade-node--document {
      background: rgba(6,182,212,0.08);
      border-color: rgba(6,182,212,0.3);
    }
    .as-cascade-node--controller {
      background: rgba(139,92,246,0.08);
      border-color: rgba(139,92,246,0.3);
    }
    .as-cascade-node--shadow {
      background: rgba(59,130,246,0.08);
      border-color: rgba(59,130,246,0.3);
    }
    .as-cascade-node--slotted {
      background: rgba(16,185,129,0.08);
      border-color: rgba(16,185,129,0.3);
    }
    .as-cascade-node-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: var(--space-1);
    }
    .as-cascade-node-desc {
      font-size: 0.875rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }
    .as-cascade-arrow {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      color: var(--text-muted);
      font-size: 1.25rem;
      position: relative;
    }
    .as-cascade-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--wc-cyan), var(--wc-accent));
      transform: translateX(-50%);
    }
    .as-cascade-arrow-icon {
      background: var(--surface-1);
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-sm);
      position: relative;
      z-index: 1;
      border: 1px solid var(--surface-3);
    }

    /* ---- Framework tab switcher ---- */
    .as-tabs { display: flex; gap: var(--space-2); margin-bottom: var(--space-6); flex-wrap: wrap; }
    .as-tab {
      padding: 0.5rem 1rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--glass-bg);
      border: 1px solid var(--glass-border-strong);
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: all 0.25s ease;
      min-height: 36px;
    }
    .as-tab:hover { color: var(--text-primary); background: var(--glass-bg-strong); }
    .as-tab.active {
      color: #fff;
      background: var(--gradient-cyan-purple);
      border-color: transparent;
      box-shadow: 0 2px 12px rgba(6,182,212,0.25);
    }
    .as-tab:focus-visible { outline: 3px solid var(--wc-accent); outline-offset: 3px; }

    .as-tab-panel { display: none; }
    .as-tab-panel.active { display: block; }

    /* ---- Comparison table ---- */
    .as-compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }
    .as-compare-table thead tr {
      border-bottom: 2px solid var(--surface-3);
    }
    .as-compare-table th {
      padding: var(--space-3) var(--space-4);
      text-align: left;
      font-weight: 700;
      color: var(--text-primary);
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .as-compare-table th:first-child { width: 30%; }
    .as-compare-table td {
      padding: var(--space-3) var(--space-4);
      color: var(--text-secondary);
      border-bottom: 1px solid var(--surface-3);
      vertical-align: top;
      line-height: 1.5;
    }
    .as-compare-table tr:last-child td { border-bottom: none; }
    .as-compare-table tr.as-compare-winner td {
      background: rgba(16,185,129,0.04);
      color: var(--text-primary);
    }
    .as-compare-table tr.as-compare-winner td:first-child {
      color: var(--wc-green);
      font-weight: 700;
    }
    .as-icon-yes { color: var(--wc-green); }
    .as-icon-partial { color: var(--wc-amber); }
    .as-icon-no  { color: var(--wc-red); }

    /* ---- Perf stat badges ---- */
    .as-perf-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
    .as-perf-stat {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border-strong);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-4);
      text-align: center;
    }
    .as-perf-stat-value {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: var(--space-2);
    }
    .as-perf-stat-label {
      font-size: 0.8125rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* ---- Internal mechanics list ---- */
