---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-flex">
  <a href={siteTitleHref} class="title-link" aria-label={siteTitle}>
    <span class="hx-logo-wrap" aria-hidden="true">
      <img
        src="/logos/hx-square.png"
        alt=""
        class="hx-logo hx-logo--dark"
        width="44"
        height="44"
      />
      <img
        src="/logos/hx-square-light.png"
        alt=""
        class="hx-logo hx-logo--light"
        width="44"
        height="44"
      />
    </span>
    <span class="hx-wordmark">HELiX</span>
  </a>

  <div class="sl-flex right-group print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex right-inner">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex !important;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }

  /* Restore an opaque, finished header. No frosted glass, no teal accent —
     just Starlight's default surface tokens so the nav reads as a clean,
     intentional band above the content with a subtle hairline divider. */
  :global(header.header) {
    background: var(--sl-color-bg-nav, var(--sl-color-bg)) !important;
    border-bottom: 1px solid var(--sl-color-hairline-shade) !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .title-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none !important;
    color: inherit;
    min-height: 44px;
    flex-shrink: 0;
  }

  .hx-logo-wrap {
    position: relative;
    display: inline-block;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }

  .hx-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hx-logo--light {
    display: none;
  }

  :global([data-theme='light']) .hx-logo--dark {
    display: none;
  }

  :global([data-theme='light']) .hx-logo--light {
    display: block;
  }

  .hx-wordmark {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1;
    background: linear-gradient(
      135deg,
      #06b6d4 0%,
      #8b5cf6 25%,
      #ec4899 50%,
      #f97316 75%,
      #06b6d4 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: hx-shimmer 8s ease-in-out infinite;
  }

  @keyframes hx-shimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @media (max-width: 23rem) {
    .hx-logo-wrap {
      display: none;
    }
  }

  .right-group {
    margin-left: auto;
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }

  .right-inner {
    gap: 1rem;
    align-items: center;
  }

  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (prefers-reduced-motion: reduce) {
    .hx-wordmark {
      animation: none;
    }
  }
</style>
