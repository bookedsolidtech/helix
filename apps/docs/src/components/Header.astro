---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import DnaHelixIcon from './DnaHelixIcon.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <DnaHelixIcon class="nav-helix-icon" />
    <SiteTitle />
  </div>

  <div class="sl-flex right-group print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex right-inner">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  /* ==========================================
     HEADER LAYOUT
     ========================================== */
  .header {
    display: flex !important;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }

  /* ==========================================
     GLASSMORPHISM NAV BAR
     ========================================== */
  :global(header.header) {
    background: rgba(7, 17, 26, 0.82) !important;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(0, 212, 200, 0.12) !important;
    box-shadow: 0 1px 24px rgba(0, 212, 200, 0.06);
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
  }

  .nav-helix-icon {
    flex-shrink: 0;
  }

  /* Hide on very small screens where space is at a premium */
  @media (max-width: 23rem) {
    .nav-helix-icon {
      display: none;
    }
  }

  .right-group {
    margin-left: auto;
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }

  .right-inner {
    gap: 1rem;
    align-items: center;
  }

  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
