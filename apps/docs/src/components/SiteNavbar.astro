---
/**
 * SiteNavbar.astro - Shared site-wide navigation bar for standalone pages.
 *
 * Replicates the Starlight Header component's visual design and functionality
 * for use on standalone Astro pages that fall outside the Starlight layout
 * (gallery, etc.).
 *
 * Features:
 * - DNA helix icon + gradient "HELiX" wordmark (matching Starlight navbar)
 * - GitHub link, theme toggle placeholder, docs link
 * - Sticky positioning with glassmorphic backdrop
 * - Full responsive behavior
 * - Respects prefers-reduced-motion
 *
 * Usage: Include at the top of ShowcaseLayout or any standalone page body.
 */
import DnaHelixIcon from './DnaHelixIcon.astro';
---

<header class="site-navbar" role="banner">
  <div class="site-navbar-inner">
    <div class="sn-title-wrapper">
      <a href="/" class="sn-logo-link" aria-label="HELIX - Back to home">
        <DnaHelixIcon class="sn-helix-icon" />
        <span class="sn-site-title">HELiX</span>
      </a>
    </div>

    <div class="sn-right-group print:hidden">
      <a href="/" class="sn-nav-link" aria-label="Documentation home">
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <span class="sn-nav-link-text">Docs</span>
      </a>
      <a
        href="https://github.com/bookedsolidtech/helix"
        class="sn-nav-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository (opens in new tab)"
      >
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        <span class="sn-nav-link-text">GitHub</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* ==========================================
     SITE NAVBAR - STANDALONE PAGES
     Mirrors Starlight Header visual design.
     ========================================== */
  .site-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--sn-height, 3.5rem);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    background: rgba(7, 17, 26, 0.82);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(0, 212, 200, 0.12);
    box-shadow: 0 1px 24px rgba(0, 212, 200, 0.06);
  }

  .site-navbar-inner {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    height: 100%;
    gap: 1rem;
  }

  /* ==========================================
     LOGO / TITLE
     ========================================== */
  .sn-title-wrapper {
    flex-shrink: 0;
  }

  .sn-logo-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none !important;
    color: inherit;
  }

  .sn-helix-icon {
    flex-shrink: 0;
  }

  .sn-site-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 900;
    font-size: 2.1rem;
    letter-spacing: -0.02em;
    line-height: 1;
    background: linear-gradient(
      135deg,
      #06b6d4 0%,
      #8b5cf6 25%,
      #ec4899 50%,
      #f97316 75%,
      #06b6d4 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: sn-shimmerFlow 8s ease-in-out infinite;
  }

  @keyframes sn-shimmerFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Hide icon on very small screens */
  @media (max-width: 23rem) {
    .sn-helix-icon {
      display: none;
    }
  }

  /* ==========================================
     RIGHT GROUP - NAV LINKS
     ========================================== */
  .sn-right-group {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .sn-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none !important;
    border-radius: 0.5rem;
    transition: color 0.2s ease, background 0.2s ease;
    min-height: 44px;
  }

  .sn-nav-link:hover {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.06);
  }

  .sn-nav-link:focus-visible {
    outline: 2px solid var(--wc-accent, hsl(250, 70%, 60%));
    outline-offset: 2px;
  }

  .sn-nav-link i {
    font-size: 0.9375rem;
  }

  .sn-nav-link-text {
    display: none;
  }

  @media (min-width: 50rem) {
    .sn-nav-link-text {
      display: inline;
    }
  }

  /* ==========================================
     REDUCED MOTION
     ========================================== */
  @media (prefers-reduced-motion: reduce) {
    .sn-site-title {
      animation: none;
    }
    .sn-nav-link {
      transition: none;
    }
  }
</style>
