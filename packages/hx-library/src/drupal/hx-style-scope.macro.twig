{#
  hx-style-scope.macro.twig
  ─────────────────────────
  Twig macro that wraps slotted Drupal content with the hx-style-scope web
  component so that injected light DOM styles resolve correctly.

  The macro sets both the `component` attribute (used by HxStyleScope to
  trigger style injection) and the `data-hx-styled` attribute (used by the
  scoped CSS selectors generated by generateScopedSelectors).

  Usage:
    {% import '@helix/hx-style-scope.macro.twig' as hx %}
    {{ hx.scope('hx-card', content) }}

  Parameters:
    component (string) — The HELiX component tag name (e.g. 'hx-card').
    content   (string) — The rendered Twig content to wrap.
#}
{% macro scope(component, content) %}
  <hx-style-scope
    component="{{ component }}"
    data-hx-styled="{{ component }}"
  >{{- content -}}</hx-style-scope>
{% endmacro %}
