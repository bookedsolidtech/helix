{
  "name": "@helixui/library",
  "version": "3.6.0",
  "description": "Enterprise Web Component Library built with Lit 3.x",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/utilities/document-token-adoption.js",
    "./dist/components/*/index.js",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./fouc.css": "./fouc.css",
    "./dist/css/helix-all.css": "./dist/css/helix-all.css",
    "./dist/css/helix-tokens.css": "./dist/css/helix-tokens.css",
    "./dist/css/helix-core.css": "./dist/css/helix-core.css",
    "./dist/css/helix-forms.css": "./dist/css/helix-forms.css",
    "./dist/css/helix-navigation.css": "./dist/css/helix-navigation.css",
    "./dist/css/helix-layout.css": "./dist/css/helix-layout.css",
    "./dist/css/helix-feedback.css": "./dist/css/helix-feedback.css",
    "./dist/css/helix-overlay.css": "./dist/css/helix-overlay.css",
    "./dist/css/helix-data.css": "./dist/css/helix-data.css",
    "./dist/css/helix-media.css": "./dist/css/helix-media.css",
    "./dist/css/helix-utility.css": "./dist/css/helix-utility.css",
    "./dist/css/manifest.json": "./dist/css/manifest.json",
    "./dist/css/index.css": "./dist/css/index.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/form-test-utils.d.ts",
    "dist/form-test-utils.d.ts.map",
    "dist/base/**",
    "dist/components/**",
    "dist/controllers/**",
    "dist/css/**",
    "dist/mixins/**",
    "dist/shared/**",
    "dist/styles/**",
    "dist/utilities/**",
    "dist/utils/**",
    "custom-elements.json",
    "figma-inventory.json",
    "fouc.css"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "vite build --watch",
    "generate:barrel": "node scripts/generate-barrel.js",
    "prepare": "node scripts/generate-barrel.js",
    "prebuild": "node scripts/generate-barrel.js",
    "build": "vite build && pnpm run cem && pnpm run css:build",
    "css:build": "node scripts/generate-css-bundles.mjs",
    "css:validate": "node scripts/validate-css.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:cross-browser": "vitest run --config vitest.config.cross-browser.ts",
    "test:coverage": "vitest run --coverage.enabled",
    "test:coverage:ci": "vitest run --coverage.enabled && node ../../scripts/check-coverage.mjs",
    "test:fast": "vitest run --bail=5",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:batch": "bash ../../scripts/test-batch.sh",
    "test:smart": "bash ../../scripts/test-smart.sh",
    "test:shard": "bash ../../scripts/test-shard.sh",
    "test:component": "vitest run",
    "cem": "custom-elements-manifest analyze --litelement --globs \"src/components/**/*.ts\" --exclude \"**/*.stories.ts\" --exclude \"**/*.styles.ts\" && node ../../scripts/validate-cem.mjs && pnpm run figma:inventory",
    "cem:watch": "custom-elements-manifest analyze --litelement --globs \"src/components/**/*.ts\" --exclude \"**/*.stories.ts\" --exclude \"**/*.styles.ts\" --watch",
    "figma:inventory": "tsx scripts/generate-figma-inventory.ts",
    "figma:inventory:check": "tsx scripts/generate-figma-inventory.ts --check",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "build:cdn": "node scripts/build-cdn.mjs",
    "generate:drupal-libraries": "tsx ../../scripts/generate-drupal-libraries.ts",
    "lint": "eslint src/",
    "clean": "rm -rf dist custom-elements.json"
  },
  "dependencies": {
    "@helixui/tokens": "workspace:*",
    "lit": "^3.3.2"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.7.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bookedsolidtech/helix.git",
    "directory": "packages/hx-library"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://helix.bookedsolid.tech",
  "bugs": "https://github.com/bookedsolidtech/helix/issues",
  "keywords": [
    "web-components",
    "lit",
    "healthcare",
    "design-system",
    "custom-elements",
    "shadow-dom",
    "wcag",
    "accessibility",
    "enterprise",
    "typescript",
    "helix"
  ],
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "esbuild": "^0.27.0",
    "@vitest/browser": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.11.1",
    "playwright": "^1.50.0",
    "typescript": "^5.7.2",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.0"
  }
}
