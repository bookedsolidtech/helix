{
  "name": "@helixui/tokens",
  "version": "0.3.4",
  "description": "Design tokens for the HELiX enterprise healthcare web component library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js",
      "default": "./dist/css.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "import": "./dist/lit.js",
      "default": "./dist/lit.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "scripts": {
    "build": "tsc && pnpm exec tsx scripts/generate-css.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bookedsolidtech/helix.git",
    "directory": "packages/hx-tokens"
  },
  "license": "MIT",
  "homepage": "https://helix.bookedsolid.tech",
  "bugs": "https://github.com/bookedsolidtech/helix/issues",
  "keywords": [
    "web-components",
    "lit",
    "healthcare",
    "design-system",
    "custom-elements",
    "design-tokens",
    "css-custom-properties",
    "wcag",
    "accessibility",
    "enterprise",
    "typescript"
  ],
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
