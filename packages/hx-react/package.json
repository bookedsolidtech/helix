{
  "name": "@helixui/react",
  "version": "3.11.2",
  "description": "React wrappers for HELiX web components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx ../../scripts/generate-react-wrappers.ts && prettier --write src/",
    "generate:check": "tsx ../../scripts/generate-react-wrappers.ts --check",
    "prebuild": "pnpm run generate",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --project tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint src/",
    "clean": "rm -rf dist src/components"
  },
  "dependencies": {
    "@helixui/library": "workspace:*",
    "@lit/react": "^1.0.6",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bookedsolidtech/helix",
    "directory": "packages/hx-react"
  }
}
