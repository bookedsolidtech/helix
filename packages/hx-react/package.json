{
  "name": "@helixui/react",
  "version": "1.1.0",
  "description": "React wrappers for HELiX web components",
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx ../../scripts/generate-react-wrappers.ts && prettier --write src/",
    "prebuild": "pnpm run generate",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist src/components"
  },
  "dependencies": {
    "@helixui/library": "workspace:*",
    "@lit/react": "^1.0.6",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
