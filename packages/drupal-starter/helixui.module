/**
 * Implements hook_theme().
 *
 * Registers the standalone HELiX Twig templates so they can be used
 * via {% include '@helixui/hx-button' %} in any theme or module template.
 */
function helixui_theme($existing, $type, $theme, $path) {
  return [
    'hx_button' => [
      'template' => 'hx-button',
      'path' => $path . '/templates',
      'variables' => [
        'variant' => 'primary',
        'size' => 'md',
        'type' => 'button',
        'href' => NULL,
        'disabled' => FALSE,
        'content' => '',
        'icon_start' => NULL,
        'icon_end' => NULL,
      ],
    ],
    'hx_card' => [
      'template' => 'hx-card',
      'path' => $path . '/templates',
      'variables' => [
        'variant' => 'default',
        'elevation' => 'raised',
        'image_url' => NULL,
        'image_alt' => '',
        'heading' => NULL,
        'body' => NULL,
        'footer' => NULL,
        'url' => NULL,
      ],
    ],
    'hx_text_input' => [
      'template' => 'hx-text-input',
      'path' => $path . '/templates',
      'variables' => [
        'name' => '',
        'label' => '',
        'type' => 'text',
        'value' => NULL,
        'placeholder' => NULL,
        'required' => FALSE,
        'disabled' => FALSE,
        'readonly' => FALSE,
        'error' => NULL,
        'help_text' => NULL,
        'pattern' => NULL,
        'maxlength' => NULL,
        'autocomplete' => NULL,
      ],
    ],
    'hx_form' => [
      'template' => 'hx-form',
      'path' => $path . '/templates',
      'variables' => [
        'action' => '',
        'method' => 'post',
        'title' => NULL,
        'description' => NULL,
        'submit_label' => 'Submit',
        'form_id' => NULL,
        'form_build_id' => NULL,
        'form_token' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 *
 * Demonstrates how to swap local library paths for CDN URLs. This is useful
 * when you want to serve @helixui/library from a CDN instead of local files.
 *
 * To enable CDN mode, set the HELIXUI_CDN_URL environment variable or
 * add $settings['helixui_cdn_url'] to settings.php.
 */
function helixui_library_info_alter(array &$libraries, $extension) {
  if ($extension !== 'helixui') {
    return;
  }

  // Check for CDN URL configuration.
  $cdn_url = getenv('HELIXUI_CDN_URL')
    ?: \Drupal::service('settings')->get('helixui_cdn_url', '');

  if (empty($cdn_url)) {
    return;
  }

  // Rewrite local /libraries/helixui/ paths to CDN URLs.
  foreach ($libraries as $name => &$library) {
    if (isset($library['js'])) {
      $new_js = [];
      foreach ($library['js'] as $path => $options) {
        if (str_starts_with($path, '/libraries/helixui/')) {
          $cdn_path = $cdn_url . str_replace('/libraries/helixui/', '/', $path);
          $options['type'] = 'external';
          $new_js[$cdn_path] = $options;
        } else {
          $new_js[$path] = $options;
        }
      }
      $library['js'] = $new_js;
    }

    if (isset($library['css'])) {
      foreach ($library['css'] as $category => &$css_files) {
        $new_css = [];
        foreach ($css_files as $path => $options) {
          if (str_starts_with($path, '/libraries/helixui/')) {
            $cdn_path = $cdn_url . str_replace('/libraries/helixui/', '/', $path);
            $options['type'] = 'external';
            $new_css[$cdn_path] = $options;
          } else {
            $new_css[$path] = $options;
          }
        }
        $css_files = $new_css;
      }
    }
  }
}
