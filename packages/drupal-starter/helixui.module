<?php

/**
 * @file
 * HELiX UI Drupal module.
 *
 * Provides integration hooks for loading HELiX web components on Drupal pages.
 * This module demonstrates per-page and per-route library attachment patterns.
 *
 * Installation:
 *   1. Place this module in modules/custom/helixui/
 *   2. Run: drush en helixui
 *   3. Clear caches: drush cr
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_page_attachments().
 *
 * Attaches the HELiX core library (tokens + runtime) to every page.
 * Individual component libraries are loaded by SDC templates via
 * attach_library(), so only the core baseline is loaded globally.
 */
function helixui_page_attachments(array &$attachments) {
  // Always load core tokens and runtime.
  $attachments['#attached']['library'][] = 'helixui/hx-core';

  // Always load Drupal behaviors for interactive components.
  $attachments['#attached']['library'][] = 'helixui/helixui-behaviors';
}

