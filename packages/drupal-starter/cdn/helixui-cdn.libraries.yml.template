# helixui-cdn.libraries.yml.template
#
# Drupal 10/11 asset library definitions for @helixui/library — CDN mode
#
# TEMPLATE — copy this file to your theme or module and replace {{CDN_URL}}
# with the actual URL where you have hosted the HELiX CDN build artifacts.
#
# Example CDN_URL values:
#   https://cdn.example.com/helix/2.1.2
#   https://your-site.example.com/sites/default/files/helix-cdn/2.1.2
#   /libraries/helix-cdn/2.1.2
#
# Usage in Twig:
#   {{ attach_library("helix_cdn/all") }}
#   {{ attach_library("helix_cdn/hx-button") }}
#   {{ attach_library("helix_cdn/hx-card") }}
#   {{ attach_library("helix_cdn/hx-text-input") }}
#
# NOTE: These libraries load Lit and all dependencies inline.
# Do NOT combine CDN libraries with the npm-based helixui libraries on the same page.

# ─────────────────────────────────────────────────────────────────────────────
# Full bundle — loads all HELiX components in a single request
# Use for prototyping, small sites, or when most components are needed site-wide.
# ─────────────────────────────────────────────────────────────────────────────

all:
  version: 2.1.2
  css:
    theme:
      {{CDN_URL}}/helix-2.1.2.min.css:
        type: external
        minified: true
  js:
    {{CDN_URL}}/helix-2.1.2.min.js:
      type: external
      attributes:
        type: module
      minified: true

# ─────────────────────────────────────────────────────────────────────────────
# Individual component libraries (Strategy B — per-component loading)
# Use these for surgical per-page loading to minimize bytes transferred.
# Each component bundles Lit inline and is fully self-contained.
#
# PERFORMANCE NOTE: When using multiple per-component entries on the same page,
# Lit will be loaded once per component (not shared). For sites using more than
# 3-4 components, the full bundle above is more efficient.
# ─────────────────────────────────────────────────────────────────────────────

