{#
/**
 * @file
 * Author Byline SDC — composes hx-avatar, hx-text, hx-link.
 *
 * Displays author attribution with avatar, name, role, and date.
 */
#}
{{ attach_library('helixui/hx-avatar') }}
{{ attach_library('helixui/hx-text') }}
{{ attach_library('helixui/hx-link') }}

<div class="author-byline">
  {% if image_url %}
    <hx-avatar
      src="{{ image_url }}"
      alt="{{ image_alt|default(name ~ ' avatar') }}"
      size="sm"
    ></hx-avatar>
  {% endif %}
  <div class="author-byline__info">
    <div class="author-byline__name-line">
      {% if url %}
        <hx-link href="{{ url }}">
          <hx-text variant="body" size="sm" weight="bold">{{ name }}</hx-text>
        </hx-link>
      {% else %}
        <hx-text variant="body" size="sm" weight="bold">{{ name }}</hx-text>
      {% endif %}
      {% if role %}
        <hx-text variant="body" size="sm" color="muted">{{ role }}</hx-text>
      {% endif %}
    </div>
    {% if date %}
      <hx-text variant="body" size="xs" color="muted">
        <time datetime="{{ date }}">{{ date }}</time>
      </hx-text>
    {% endif %}
  </div>
</div>
