{#
/**
 * @file
 * Carousel SDC — primitive wrapper for hx-carousel.
 *
 * This is the primitive component SDC. For Views-based carousel layouts,
 * use the views-carousel SDC instead which handles Views row rendering.
 *
 * Render hx-carousel-item elements in the default slot. For accessible
 * autoplay carousels, consider the motion sensitivity guidance in the
 * HELiX accessibility docs — always test with prefers-reduced-motion.
 */
#}
{{ attach_library('helixui/hx-carousel') }}

<hx-carousel
  {% if label and label != 'Carousel' %}label="{{ label }}"{% endif %}
  {% if loop %}loop{% endif %}
  {% if autoplay %}autoplay{% endif %}
  {% if autoplay_interval and autoplay_interval != 3000 %}autoplay-interval="{{ autoplay_interval }}"{% endif %}
  {% if slides_per_page and slides_per_page != 1 %}slides-per-page="{{ slides_per_page }}"{% endif %}
  {% if orientation and orientation != 'horizontal' %}orientation="{{ orientation }}"{% endif %}
  {% if mouse_dragging %}mouse-dragging{% endif %}
  {{ attributes ? attributes }}
>
  {% if content %}
    {{ content }}
  {% endif %}
</hx-carousel>
