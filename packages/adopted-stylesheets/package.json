{
  "name": "@helixui/adopted-stylesheets",
  "version": "0.1.0",
  "description": "Framework-agnostic adopted stylesheets registry with Lit ReactiveController wrapper",
  "type": "module",
  "main": "./dist/adopted-stylesheets.cjs",
  "module": "./dist/adopted-stylesheets.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/adopted-stylesheets.js",
      "require": "./dist/adopted-stylesheets.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bookedsolidtech/helix.git",
    "directory": "packages/adopted-stylesheets"
  },
  "license": "MIT",
  "homepage": "https://helix.bookedsolid.tech",
  "bugs": "https://github.com/bookedsolidtech/helix/issues",
  "keywords": [
    "web-components",
    "lit",
    "adopted-stylesheets",
    "css",
    "shadow-dom",
    "healthcare",
    "design-system",
    "enterprise",
    "typescript"
  ],
  "devDependencies": {
    "lit": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
