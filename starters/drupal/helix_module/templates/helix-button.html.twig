{#
  helix-button.html.twig
  ----------------------
  Renders a HELiX hx-button component from a Drupal render array or
  direct template include.

  Maps Drupal form button elements (type: submit, button) to the
  hx-button custom element. Can also be used directly in Twig templates
  for non-form buttons and link-style buttons (href).

  Note on hx-size: The size attribute is prefixed as `hx-size` on the
  custom element to avoid conflicts with the native HTML `size` attribute.

  Variables:
    label      (string)  Visible button label text.
    variant    (string)  primary | secondary | tertiary | danger | ghost | outline.
                         Default: 'primary'.
    size       (string)  sm | md | lg. Default: 'md'. Rendered as hx-size.
    disabled   (bool)    Renders the button in a disabled state.
    loading    (bool)    Shows spinner and prevents interaction.
    type       (string)  button | submit | reset. Default: 'button'.
    href       (string)  When set, renders an anchor. Overrides type.
    target     (string)  Anchor target (_blank etc.). Only used with href.
    name       (string)  Form field name for ElementInternals participation.
    value      (string)  Form field value submitted with name.
    aria_label (string)  Accessible name for icon-only buttons.
    attributes (Attribute|map)
                         Additional HTML attributes — either a Drupal Attribute object
                         (the render-array / Form-API path) or a plain map for a direct
                         {% include %}, e.g. attributes: {'data-test': 'x'}. Both are
                         iterated safely: only well-formed attribute NAMES are emitted
                         (closing the attribute-name injection the original raw
                         key/value loop allowed), while legitimate attributes such as
                         `style` (for --hx-* theming) pass through unchanged.

  Usage — direct include:
    {% include 'helix-button.html.twig' with {
      label: 'Save Patient Record',
      variant: 'primary',
      type: 'submit',
    } %}

  Usage — link button:
    {% include 'helix-button.html.twig' with {
      label: 'View Lab Results',
      variant: 'ghost',
      href: node.field_results_url.value,
      target: '_blank',
    } %}

  Drupal Form API — automatic via preprocess:
    The helix_module_preprocess_button() function in helix_module.theme.inc
    maps form render arrays to these variables automatically.
#}

<hx-button
  variant="{{ variant|default('primary') }}"
  hx-size="{{ size|default('md') }}"
  {% if disabled %}disabled{% endif %}
  {% if loading %}loading{% endif %}
  {% if type is defined and not href %}type="{{ type|default('button') }}"{% endif %}
  {% if href %}href="{{ href }}"{% endif %}
  {% if target %}target="{{ target }}"{% endif %}
  {% if name %}name="{{ name }}"{% endif %}
  {% if value %}value="{{ value }}"{% endif %}
  {% if aria_label %}aria-label="{{ aria_label }}"{% endif %}
  {# SECURITY: `attributes` may be a Drupal Attribute object (render-array / Form-API
     path) or a plain map (direct {% include %}). Iterate either and emit only
     well-formed attribute NAMES — this closes the attribute-name injection the
     original raw `{{ key }}` loop allowed (Twig escapes the value, not the name)
     while PRESERVING every legitimate attribute, including `style` for --hx-* theming
     and `formaction` on form buttons (these are developer-controlled here, not
     untrusted input). See helix_module.theme.inc. #}
  {% for attr_name, attr_value in attributes|default({}) %}{% if attr_name matches '/^[a-zA-Z][a-zA-Z0-9:_.-]*$/' %}{{ attr_name }}="{{ attr_value }}" {% endif %}{% endfor %}
>
  {%- set prefix_content %}{% block prefix %}{% endblock %}{% endset -%}
  {%- if prefix_content %}<span slot="prefix">{{ prefix_content }}</span>{% endif -%}
  {%- block default %}{%- if label %}{{ label }}{% endif -%}{% endblock -%}
  {%- set suffix_content %}{% block suffix %}{% endblock %}{% endset -%}
  {%- if suffix_content %}<span slot="suffix">{{ suffix_content }}</span>{% endif -%}
</hx-button>
