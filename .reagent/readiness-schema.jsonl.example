# Example 3: WARN — missing test coverage (qa-engineer-automation, Group 2)
{"timestamp":"2026-04-16T10:22:08Z","pipeline_id":"helix-3.0.0-readiness","phase":"evaluate","group_id":"user-experience","agent_id":"qa-engineer-automation","component":"hx-carousel","dimension":"test-coverage-pct","score":62,"severity":"major","status":"warn","finding":"Test file exists but covers only 62% of branches. Missing tests for: keyboard arrow navigation, wrap-around behavior, autoplay pause on focus, touch swipe gestures.","evidence":"packages/hx-library/src/components/hx-carousel/hx-carousel.test.ts","remediation":"Add test cases for keyboard nav (ArrowLeft/ArrowRight), wrap-around logic, autoplay pause/resume, and touch event handling.","tags":["test-gap","interactive"],"blocking":false,"effort_estimate":"medium"}

# Example 4: FAIL — bundle size violation (performance-engineer, Group 3)
{"timestamp":"2026-04-16T11:05:44Z","pipeline_id":"helix-3.0.0-readiness","phase":"evaluate","group_id":"production-readiness","agent_id":"performance-engineer","component":"hx-data-table","dimension":"bundle-size","score":40,"severity":"critical","status":"fail","finding":"Component min+gz size is 8.2KB, exceeding the 5KB per-component threshold. Includes inline sorting logic that should be tree-shakeable.","evidence":"dist/components/hx-data-table/hx-data-table.js (8,241 bytes gzipped)","remediation":"Extract sorting and filtering logic into separate importable modules. Use dynamic imports for optional features (column resize, virtual scroll).","tags":["perf-budget","tree-shaking"],"blocking":true,"effort_estimate":"large"}

