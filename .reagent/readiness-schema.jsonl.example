# Example 1: FAIL — critical a11y issue (accessibility-engineer, Group 2)
{"timestamp":"2026-04-16T09:12:34Z","pipeline_id":"helix-3.0.0-readiness","phase":"evaluate","group_id":"user-experience","agent_id":"accessibility-engineer","component":"hx-select","dimension":"aria-compliance","score":35,"severity":"critical","status":"fail","finding":"Missing aria-expanded attribute on trigger button. Screen readers cannot determine open/closed state of the dropdown.","evidence":"packages/hx-library/src/components/hx-select/hx-select.ts:142","remediation":"Add aria-expanded=${this.open} to the trigger button element in the render template.","tags":["wcag-4.1.2","form-control","screen-reader"],"blocking":true,"effort_estimate":"small"}

