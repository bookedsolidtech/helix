# Example 6: WARN — type safety concern (typescript-specialist, Group 1)
{"timestamp":"2026-04-16T08:58:22Z","pipeline_id":"helix-3.0.0-readiness","phase":"evaluate","group_id":"code-quality","agent_id":"typescript-specialist","component":"hx-combobox","dimension":"type-safety","score":72,"severity":"major","status":"warn","finding":"Event detail types use Record<string, unknown> instead of strongly typed interfaces. Consumers cannot type-narrow event.detail without casting.","evidence":"packages/hx-library/src/components/hx-combobox/hx-combobox.ts:89,203","remediation":"Define HxComboboxChangeDetail and HxComboboxInputDetail interfaces. Use CustomEvent<HxComboboxChangeDetail> for dispatched events.","tags":["public-api","event-typing"],"blocking":false,"effort_estimate":"small"}

# Example 7: FAIL — missing keyboard navigation (accessibility-engineer, Group 2)
{"timestamp":"2026-04-16T09:18:55Z","pipeline_id":"helix-3.0.0-readiness","phase":"evaluate","group_id":"user-experience","agent_id":"accessibility-engineer","component":"hx-tabs","dimension":"keyboard-navigation","score":48,"severity":"critical","status":"fail","finding":"Arrow key navigation between tabs is not implemented. WCAG 2.1 SC 2.1.1 requires all functionality be operable via keyboard. Tab panel activation requires mouse click only.","evidence":"packages/hx-library/src/components/hx-tabs/hx-tabs.ts:95-140","remediation":"Implement roving tabindex pattern: ArrowLeft/ArrowRight to move focus between tabs, Enter/Space to activate, Home/End to jump to first/last tab.","tags":["wcag-2.1.1","roving-tabindex","keyboard"],"blocking":true,"effort_estimate":"medium"}

